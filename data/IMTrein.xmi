					</ownedComment>
				</packagedElement>
				<packagedElement xmi:type="uml:DataType" xmi:id="Ua701110a-aa6b-41e6-ba25-f269dc3076fb" xmi:uuid="a701110a-aa6b-41e6-ba25-f269dc3076fb" name="Year">
					<xmi:Extension extender="UModel">
						<attributeExtension DocComment="Ueaf21d09-c57e-436d-9518-1c61ad0fdb54"/>
					</xmi:Extension>
					<ownedComment xmi:type="uml:Comment" xmi:id="Ueaf21d09-c57e-436d-9518-1c61ad0fdb54" xmi:uuid="eaf21d09-c57e-436d-9518-1c61ad0fdb54" body="4-cijferig jaar uitgedrukt in yyyy conform https://en.wikipedia.org/wiki/ISO_8601">
						<annotatedElement xmi:idref="Ua701110a-aa6b-41e6-ba25-f269dc3076fb"/>
					</ownedComment>
