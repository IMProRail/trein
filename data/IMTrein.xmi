							</xmi:Extension>
							<ownedComment xmi:type="uml:Comment" xmi:id="U7e72be14-f886-437c-b3ab-a7205670c424" xmi:uuid="7e72be14-f886-437c-b3ab-a7205670c424" body="De verzameling van waarden die gegevens van deze attribuutsoort kunnen hebben, oftewel het waardenbereik, uitgedrukt in een specifieke structuur.">
								<annotatedElement xmi:idref="U84bf66fc-f971-453e-8617-21787120c0d4"/>
							</ownedComment>
						</ownedAttribute>
						<ownedAttribute xmi:type="uml:Property" xmi:id="U7b4103e3-9bed-4072-a2df-d62233320ac4" xmi:uuid="7b4103e3-9bed-4072-a2df-d62233320ac4" name="Formeel patroon" visibility="public">
							<xmi:Extension extender="UModel">
								<attributeExtension DocComment="U5c1446f1-fec3-4b51-a7f7-b7b3caaaf4b9"/>
