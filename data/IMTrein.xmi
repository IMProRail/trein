				<packagedElement xmi:type="uml:Enumeration" xmi:id="U348ed8f0-361f-4eae-a5ad-b31e3b5c9722" xmi:uuid="348ed8f0-361f-4eae-a5ad-b31e3b5c9722" name="Relatiemodelleringstype">
					<ownedAttribute xmi:type="uml:Property" xmi:id="U60f1bdf5-a137-410c-863a-afc45e67dcbd" xmi:uuid="60f1bdf5-a137-410c-863a-afc45e67dcbd" name="Relatiesoort_leidend" visibility="public"/>
