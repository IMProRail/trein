					<ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="U9ec11c54-a2bb-41e4-bc71-6f7d64616305" xmi:uuid="9ec11c54-a2bb-41e4-bc71-6f7d64616305" name="Conceptueel"/>
